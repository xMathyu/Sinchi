# Variables de apps/web.
#
# Copia este archivo a `.env.local` y complétalo. Ninguna de estas es un secreto
# de verdad —la `apiKey` de Firebase identifica el proyecto y el id de cliente de
# Google viaja en el HTML de cualquier sitio que use Google Sign-In— pero el
# archivo no se versiona por dos razones prácticas, las mismas que en la app:
# el escáner de GitHub marca cualquier `AIza…` y un aviso que siempre es falso
# entrena a ignorar los avisos; y desarrollo y producción deberían apuntar a
# proyectos distintos, cosa que un valor por defecto en el código vuelve fácil de
# equivocar.
#
# La landing funciona sin ninguna de estas. Lo que las necesita es `/panel`.

# ---------------------------------------------------------------------------
# La api
# ---------------------------------------------------------------------------

# A dónde habla el SERVIDOR de Next. No lleva `NEXT_PUBLIC_` a propósito: el
# navegador nunca llama a la api —lo hace el servidor, con el token de la cookie
# `httpOnly`— así que la dirección interna no tiene por qué viajar al cliente.
#
# En local, con la api en el 3000:  http://localhost:3000/v1
# En producción: https://sinchi-api-961173851857.us-east4.run.app/v1
SINCHI_API_URL=http://localhost:3000/v1

# ---------------------------------------------------------------------------
# Firebase (el intercambio corre en el servidor)
# ---------------------------------------------------------------------------

# La `apiKey` del proyecto. Se saca con:
#   gcloud --project sinchi-a95913 services api-keys list --format="value(uid,displayName)"
#   gcloud --project sinchi-a95913 services api-keys get-key-string <UID> --format="value(keyString)"
FIREBASE_API_KEY=

# El dominio de auth del proyecto. Identity Toolkit lo exige como `requestUri` al
# canjear la credencial de Google, aunque no haya redirección real.
FIREBASE_AUTH_DOMAIN=sinchi-a95913.firebaseapp.com

# ---------------------------------------------------------------------------
# Google Sign-In (opcional)
# ---------------------------------------------------------------------------

# El id de cliente OAuth de tipo *web*. Sin esto el botón de Google NO se dibuja
# y el panel se queda con correo y contraseña, que funciona igual: es la misma
# comprobación que hace la app con `googleAuthReady()`.
#
# Se crea a mano en la consola de Firebase —no hay api pública para crear
# clientes OAuth, y el rodeo que existía (`gcloud alpha iap oauth-brands`) Google
# lo apagó el 19 de marzo de 2026:
#   https://console.firebase.google.com/project/sinchi-a95913/authentication/providers
#   Google -> activar -> elegir correo de soporte -> guardar
#
# IMPORTANTE: en «Orígenes autorizados de JavaScript» del cliente web hay que
# añadir el dominio desde el que se sirve el panel (http://localhost:3000 en
# local, https://sinchi.fit en producción). Sin eso, GIS no dibuja el botón y el
# único rastro es un error en la consola del navegador.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Metadatos
# ---------------------------------------------------------------------------

# Para que `og:image` salga absoluta. Sin esto, ni WhatsApp ni Twitter resuelven
# la vista previa.
NEXT_PUBLIC_SITE_URL=https://sinchi.fit
