{
  "name": "@sinchi/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS — dominio, cobro y check-in sobre Postgres (Neon)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "saas:status": "tsx src/db/saas-cli.ts status",
    "saas:pay": "tsx src/db/saas-cli.ts pay",
    "saas:promo": "tsx src/db/saas-cli.ts promo",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed:kaizen": "tsx src/db/seed-kaizen.ts",
    "db:seed:fa-meng-chuen": "tsx src/db/seed-fa-meng-chuen.ts",
    "db:purge": "tsx src/db/purge-tenants.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@noble/hashes": "^2.3.0",
    "@sinchi/shared": "*",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "firebase-admin": "^14.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.9"
  }
}
