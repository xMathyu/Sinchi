# HACEN FALTA DOS CADENAS, y no es una formalidad.
#
# El rol que Neon crea por defecto (`neondb_owner`) tiene BYPASSRLS = true. Si la
# api se conecta con el, las politicas de aislamiento por tenant NO se le aplican
# y el unico filtro real es el del repositorio. Compruebalo con:
#
#   select rolsuper, rolbypassrls from pg_roles where rolname = current_user;
#
# Asi que:
#   DATABASE_URL            la api. Rol `sinchi_app`, sin BYPASSRLS, sujeto a RLS.
#   MIGRATION_DATABASE_URL  las migraciones. Rol dueno del esquema.
#
# El rol de la api se crea una vez con scripts/setup-app-role.sql.
#
# Usa la cadena del POOLER en las dos (tiene "-pooler" en el host): la api abre y
# cierra conexiones por peticion y el pooler es el que aguanta eso sin agotar el
# limite del proyecto.
#
# No incluyas `channel_binding=require`: es un parametro de libpq que
# node-postgres no implementa, y deja la falsa impresion de estar activo.
DATABASE_URL="postgresql://sinchi_app:CLAVE@ep-algo-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
MIGRATION_DATABASE_URL="postgresql://neondb_owner:CLAVE@ep-algo-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar los JWT de sesion. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Clave de cifrado en reposo (32 bytes en base64). Cifra el secreto TOTP de cada
# alumno y las credenciales de pasarela de cada gimnasio. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes, todos los QR emitidos dejan de valer y los alumnos tienen que
# volver a vincular su dispositivo. Guardala en un gestor de secretos.
ENCRYPTION_KEY=""

# Puerto de la api.
PORT=3000

# Zona horaria de referencia del producto. No cambiarla sin leer MD 4.1.
DEFAULT_TIMEZONE="America/Lima"

# Deja la puerta de desarrollo abierta en /auth/dev-login. NUNCA en produccion.
ALLOW_DEV_LOGIN="true"

# Proyecto de Firebase contra el que se verifican los ID tokens del login.
#
# En Cloud Run NO hace falta: se deriva de `GOOGLE_CLOUD_PROJECT`, que la
# plataforma inyecta. En local esa variable no existe, y sin esta el login
# responde "La autenticacion con Firebase no esta configurada: falta
# FIREBASE_PROJECT_ID" — un error que acusa a la configuracion del despliegue
# cuando lo que falta es esta linea.
#
# Solo se necesita el id. Verificar un ID token descarga las claves publicas de
# Google por HTTP, asi que no hacen falta credenciales de servicio: una cuenta
# de servicio menos que administrar.
FIREBASE_PROJECT_ID="sinchi-a95913"

# --- Correo (Resend) ---------------------------------------------------
# Envio de invitaciones. OPCIONAL: sin esto la invitacion se crea igual y se
# comparte por enlace (WhatsApp), que es el canal que de verdad se lee en Peru.
# El correo es entrega, no la fuente del vinculo.
RESEND_API_KEY=""

# Remitente. `onboarding@resend.dev` es el dominio compartido de Resend y solo
# entrega al correo del duenno de la cuenta: sirve para probar, NO para invitar
# alumnos. Para eso hace falta un dominio propio verificado con SPF y DKIM.
MAIL_FROM="Sinchi <onboarding@resend.dev>"

# De donde cuelgan las URLs que salen hacia fuera: el enlace de la invitacion y
# el logo del correo. Tienen que ser PUBLICAS — un cliente de correo no abre
# `sinchi://` ni pinta una imagen de localhost.
#
# Por defecto el servicio desplegado, incluso corriendo en local, y es correcto:
# la api local y Cloud Run comparten base, asi que un token emitido aqui vale
# alli. Un correo enviado desde el portatil lleva enlaces que funcionan.
PUBLIC_BASE_URL="https://sinchi-api-961173851857.us-east4.run.app"

# Fichas de la app en las tiendas.
#
# Las usa la pagina que abre el enlace de una invitacion: si quien lo abre no
# tiene la app, es lo unico que puede ofrecerle. Y son las mismas que la landing
# pone en sus botones (NEXT_PUBLIC_IOS_STORE_URL / NEXT_PUBLIC_ANDROID_STORE_URL
# en apps/web).
#
# Google Play direcciona por el nombre del paquete, asi que su valor por defecto
# ya es correcto y no hace falta ponerlo. Apple direcciona por un id numerico que
# solo existe cuando la app esta publicada: hasta que lo tengas, dejala vacia y
# la pagina no ensenara un boton que lleva a «no encontrado».
IOS_STORE_URL=""
ANDROID_STORE_URL="https://play.google.com/store/apps/details?id=pe.sinchi.app"
