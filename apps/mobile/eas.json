{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/schema/eas.schema.json",
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sinchi-api-961173851857.us-east4.run.app/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sinchi-api-961173851857.us-east4.run.app/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://sinchi-api-961173851857.us-east4.run.app/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
