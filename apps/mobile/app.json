{
  "expo": {
    "name": "Sinchi",
    "slug": "sinchi",
    "version": "0.1.0",
    "scheme": "sinchi",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08080A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.sinchi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Sinchi usa la cámara para escanear el QR de los alumnos en la puerta."
      }
    },
    "android": {
      "package": "pe.sinchi.app",
      "adaptiveIcon": {
        "backgroundColor": "#08080A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Sinchi usa la cámara para escanear el QR de los alumnos en la puerta."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f43ddb28-dc9f-47d3-a6e3-309ed32f7016"
      }
    },
    "owner": "mathyus-team"
  }
}
